<Window x:Class="BootScope.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="BootScope Settings" Height="380" Width="420" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="Margin" Value="0,10,0,2" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="Padding" Value="4" />
            </Style>
        </Grid.Resources>

        <CheckBox Grid.Row="0" Content="Launch BootScope when I log into Windows"
                  IsChecked="{Binding LaunchAtLogin}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,4" />

        <StackPanel Grid.Row="1">
            <TextBlock Text="Startup scan delay (seconds) — how long BootScope waits after login before scanning, so it doesn't add to boot load" TextWrapping="Wrap" />
            <TextBox Text="{Binding StartupScanDelaySeconds, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Refresh interval (seconds)" />
            <TextBox Text="{Binding RefreshIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <StackPanel Grid.Row="3">
            <TextBlock Text="CPU warning threshold (%)" />
            <TextBox Text="{Binding CpuWarningThresholdPercent, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <StackPanel Grid.Row="4">
            <TextBlock Text="RAM warning threshold (%)" />
            <TextBox Text="{Binding RamWarningThresholdPercent, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save" Width="90" Margin="0,0,8,0" Click="Save_Click" Style="{StaticResource ToolbarButtonStyle}" />
            <Button Content="Cancel" Width="90" Click="Cancel_Click" Style="{StaticResource ToolbarButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
