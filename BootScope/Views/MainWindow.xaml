<Window x:Class="BootScope.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:BootScope.Models"
        mc:Ignorable="d"
        Title="BootScope - Startup Diagnostics" Height="720" Width="1180" MinWidth="900" MinHeight="500"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Dashboard summary cards: total CPU / RAM / Disk / Network usage -->
        <UniformGrid Grid.Row="0" Rows="1" Columns="4">
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="CPU USAGE" Style="{StaticResource MetricLabelStyle}" />
                    <TextBlock Text="{Binding CpuUsagePercent, Mode=OneWay, StringFormat={}{0:0.0}%}" Style="{StaticResource MetricValueStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="MEMORY USAGE" Style="{StaticResource MetricLabelStyle}" />
                    <TextBlock Text="{Binding MemoryUsagePercent, Mode=OneWay, StringFormat={}{0:0.0}%}" Style="{StaticResource MetricValueStyle}" />
                    <TextBlock Style="{StaticResource MetricLabelStyle}">
                        <Run Text="{Binding MemoryUsedMb, Mode=OneWay, StringFormat={}{0:0}}" /><Run Text=" / " /><Run Text="{Binding MemoryTotalMb, Mode=OneWay, StringFormat={}{0:0}}" /><Run Text=" MB" />
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="DISK USAGE" Style="{StaticResource MetricLabelStyle}" />
                    <TextBlock Text="{Binding DiskUsagePercent, Mode=OneWay, StringFormat={}{0:0.0}%}" Style="{StaticResource MetricValueStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="NETWORK USAGE" Style="{StaticResource MetricLabelStyle}" />
                    <TextBlock Text="{Binding NetworkUsageKbPerSec, Mode=OneWay, StringFormat={}{0:0.0} KB/s}" Style="{StaticResource MetricValueStyle}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Toolbar: process actions and filter box -->
        <DockPanel Grid.Row="1" Margin="4,4,4,8" LastChildFill="True">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                <Button Content="Stop Selected" Command="{Binding StopProcessCommand}" Style="{StaticResource DangerButtonStyle}"
                        ToolTip="Requires confirmation. BootScope never closes a process automatically." />
                <Button Content="Open File Location" Command="{Binding OpenFileLocationCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                <Button Content="Properties" Command="{Binding ShowPropertiesCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                <Button Content="Search Online" Command="{Binding SearchWebCommand}" Style="{StaticResource ToolbarButtonStyle}" />
            </StackPanel>
            <Button Content="Settings" Click="OpenSettings_Click" DockPanel.Dock="Right" Style="{StaticResource ToolbarButtonStyle}" HorizontalAlignment="Right" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,12,0">
                <TextBlock Text="Filter:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Width="220"
                         Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderBrush}" Padding="4" />
            </StackPanel>
        </DockPanel>

        <!-- Live, sortable, filterable process table -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding ProcessesView}"
                  SelectedItem="{Binding SelectedProcess}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserSortColumns="True"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  RowStyle="{StaticResource ProcessRowStyle}"
                  Background="{StaticResource SurfaceBrush}"
                  Foreground="{StaticResource TextPrimaryBrush}"
                  BorderBrush="{StaticResource BorderBrush}"
                  RowBackground="Transparent"
                  AlternatingRowBackground="#252530">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Process" Binding="{Binding Name}" Width="150" />
                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="60" />
                <DataGridTextColumn Header="CPU %" Binding="{Binding CpuUsagePercent, StringFormat={}{0:0.0}}" Width="70" />
                <DataGridTextColumn Header="Memory (MB)" Binding="{Binding MemoryUsageMb, StringFormat={}{0:0.0}}" Width="100" />
                <DataGridTextColumn Header="Memory %" Binding="{Binding MemoryUsagePercent, StringFormat={}{0:0.0}}" Width="80" />
                <DataGridTextColumn Header="Disk (MB/s)" Binding="{Binding DiskUsageMbPerSec, StringFormat={}{0:0.00}}" Width="90" />
                <DataGridTextColumn Header="Network (KB/s)" Binding="{Binding NetworkUsageKbPerSec, StringFormat={}{0:0.0}}" Width="110" />
                <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="150" />
                <DataGridCheckBoxColumn Header="Windows" Binding="{Binding IsWindowsProcess}" Width="70" />
                <DataGridCheckBoxColumn Header="Starts w/ Windows" Binding="{Binding StartsWithWindows}" Width="110" />
                <DataGridTextColumn Header="Safety" Binding="{Binding SafetyLevel}" Width="150" />
                <DataGridTextColumn Header="Recommendation" Binding="{Binding Recommendation}" Width="140" />
                <DataGridTextColumn Header="Path" Binding="{Binding ExecutablePath}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status bar -->
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" Margin="6,6,6,0" />
    </Grid>
</Window>
